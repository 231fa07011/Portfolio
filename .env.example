# Root Environment Configuration Example

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=YOUR_GOOGLE_ANALYTICS_MEASUREMENT_ID

# Web3Forms Public Access Key (obtain your free key at https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Optional Express Backend API URL (for local development)
VITE_API_URL=http://localhost:5000/api

