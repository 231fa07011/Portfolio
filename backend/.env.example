# Server Port
PORT=5000

# Environment (development | production)
NODE_ENV=development

# Allowed Client Origin (Frontend URL in Production, e.g. https://your-portfolio.vercel.app)
CLIENT_URL=http://localhost:5173

# Optional: Nodemailer Email Service Configuration
# If left empty, contact form submissions are validated in-memory without persistent delivery.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# CONTACT_EMAIL=nagamounika624@gmail.com

